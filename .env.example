# Copy to .env and fill in locally. Never commit the real .env.
# The system runs with zero keys set (extractive-fallback chat client) --
# these are only needed for LLM-generated (rather than extractive) answers.

# Any Anthropic model string, e.g. claude-sonnet-4-6, claude-opus-4-1.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required only if you want real LLM-generated chat answers instead of
# the built-in extractive fallback. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override where per-request trace JSON files are written.
DELTA_CHAT_RUNS_DIR=runs
