# Copy to .env and fill in locally. Never commit the real .env.
# The system runs with zero keys set (extractive-fallback chat client) --
# these are only needed for LLM-generated (rather than extractive) answers.

# --- Groq (this submission's configured provider) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (second reference provider, kept to show the LLM client
#     is genuinely swappable, not built around one vendor) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: force a specific provider instead of auto-detecting from
# whichever *_API_KEY is set. One of: groq | anthropic
LLM_PROVIDER=groq

# Optional: override where per-request trace JSON files are written.
DELTA_CHAT_RUNS_DIR=runs
